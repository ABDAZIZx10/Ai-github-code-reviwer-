# =============================================================================
# Configuration template — copy to .env and fill in real values.
# NEVER commit .env, *.pem private keys, or personal access tokens.
# =============================================================================

# --- GitHub Actions repository secrets (set in GitHub UI, not only in .env) ---
# N8N_WEBHOOK_URL=https://your-n8n-host/webhook/ci-failure-review
# N8N_WEBHOOK_SECRET=replace-with-a-long-random-string

# --- Local / n8n GitHub App authentication ---
# Used by scripts/generate_github_app_jwt.py and by the reconstructed n8n flow.
GITHUB_APP_CLIENT_ID=Iv23li_your_client_id
GITHUB_APP_ID=0000000
GITHUB_APP_INSTALLATION_ID=000000000
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem

# Optional: personal access token for manual API debugging (not required by GHA)
# GITHUB_TOKEN=ghp_replace_me

# --- LLM provider (configure inside n8n credentials UI) ---
# Choose ONE provider and set the matching credential in n8n.
# OPENAI_API_KEY=sk-replace_me
# GOOGLE_AI_API_KEY=replace_me

# --- Local n8n (docker-compose) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-now
GENERIC_TIMEZONE=UTC
